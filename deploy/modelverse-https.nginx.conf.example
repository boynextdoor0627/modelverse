server {
    listen 80;
    listen [::]:80;
    server_name modelverse.tech www.modelverse.tech;
    return 301 https://modelverse.tech$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name modelverse.tech www.modelverse.tech;

    # Replace these two paths with the certificate paths shown in Alibaba Cloud SSL Certificates Service.
    ssl_certificate /etc/nginx/ssl/modelverse.tech.pem;
    ssl_certificate_key /etc/nginx/ssl/modelverse.tech.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 10m;
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
